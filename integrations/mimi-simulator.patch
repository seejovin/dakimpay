+type dakimTestFields = map[string]any
+
+// All fields below are supplied by the synthetic provider. Tests mutate one
+// claim at a time to ensure each missing or ambiguous fact keeps the order held.
+func testDakimReversal(order string, first, second int64) dakimTestFields {
+	legs := []dakimTestFields{}
+	for i, amount := range []int64{first, second} {
+		if amount == 0 {
+			continue
+		}
+		legs = append(legs, dakimTestFields{
+			"id": fmt.Sprintf("dr_test_%d", i), "payment_id": "dp_sale",
+			"merchant_id": "mimi", "currency": "USD", "amount": amount, "status": "succeeded",
+			"reference": fmt.Sprintf("rf_test-%d", i), "merchant_operation": fmt.Sprintf("external-%d", i),
+			"charge_reference": "ch_test-sale",
+		})
+	}
+	return dakimTestFields{"complete": true, "dispute_status": "none", "refunds": legs, "payment": dakimTestFields{
+		"id": "dp_sale", "merchant_id": "mimi", "order_id": "MIMI-" + order, "terminal_id": "MIMI-01",
+		"channel": "terminal", "brand": "visa", "status": "captured", "reference": "ch_test-sale", "amount": 360, "currency": "USD", "refunded": first + second,
+	}}
+}
+
+func TestDakimFullReversalRequiresCompleteBoundLegs(t *testing.T) {
+	job := CardJob{ID: "order", Kind: "charge", Remote: "dp_sale", Amount: 360, Currency: "USD", Digits: 2, Merchant: "mimi", Provider: "dakim-simulator", Reader: "MIMI-01"}
+	type mutate func(dakimTestFields, dakimTestFields, []dakimTestFields)
+	cases := []struct {
+		name   string
+		change mutate
+		allow  bool
+	}{
+		{"complete", nil, true},
+		{"false completeness", func(v, p dakimTestFields, r []dakimTestFields) { v["complete"] = false }, false},
+		{"missing dispute", func(v, p dakimTestFields, r []dakimTestFields) { delete(v, "dispute_status") }, false},
+		{"open dispute", func(v, p dakimTestFields, r []dakimTestFields) { v["dispute_status"] = "open" }, false},
+		{"unknown dispute scope", func(v, p dakimTestFields, r []dakimTestFields) { v["dispute_status"] = "unknown" }, false},
+		{"unrecognized dispute evidence", func(v, p dakimTestFields, r []dakimTestFields) { v["dispute_status"] = "clearish" }, false},
+		{"pending refund", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["status"] = "pending" }, false},
+		{"payment ID", func(v, p dakimTestFields, r []dakimTestFields) { p["id"] = "dp_other" }, false},
+		{"terminal", func(v, p dakimTestFields, r []dakimTestFields) { p["terminal_id"] = "MIMI-02" }, false},
+		{"order", func(v, p dakimTestFields, r []dakimTestFields) { p["order_id"] = "MIMI-another" }, false},
+		{"merchant", func(v, p dakimTestFields, r []dakimTestFields) { p["merchant_id"] = "other" }, false},
+		{"unconfirmed authorization", func(v, p dakimTestFields, r []dakimTestFields) { p["status"] = "authorized" }, false},
+		{"source missing charge", func(v, p dakimTestFields, r []dakimTestFields) { delete(p, "reference") }, false},
+		{"wrong leg parent", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["payment_id"] = "dp_other" }, false},
+		{"wrong leg source charge", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["charge_reference"] = "ch_other" }, false},
+		{"wrong leg merchant", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["merchant_id"] = "other" }, false},
+		{"wrong leg currency", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["currency"] = "EUR" }, false},
+		{"duplicate refund", func(v, p dakimTestFields, r []dakimTestFields) { r[1]["id"] = r[0]["id"] }, false},
+		{"duplicate provider reference", func(v, p dakimTestFields, r []dakimTestFields) { r[1]["reference"] = r[0]["reference"] }, false},
+		{"duplicate request", func(v, p dakimTestFields, r []dakimTestFields) {
+			r[1]["merchant_operation"] = r[0]["merchant_operation"]
+		}, false},
+		{"excess refund", func(v, p dakimTestFields, r []dakimTestFields) { r[0]["amount"] = int64(1<<63 - 1) }, false},
+		{"aggregate mismatches lines", func(v, p dakimTestFields, r []dakimTestFields) { p["refunded"] = 359 }, false},
+		{"missing line list", func(v, p dakimTestFields, r []dakimTestFields) { delete(v, "refunds") }, false},
+		{"only partial", func(v, p dakimTestFields, r []dakimTestFields) { v["refunds"] = r[:1]; p["refunded"] = 100 }, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			reply := testDakimReversal(job.ID, 100, 260)
+			if tc.change != nil {
+				tc.change(reply, reply["payment"].(dakimTestFields), reply["refunds"].([]dakimTestFields))
+			}
+			httpProvider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != "GET" || r.URL.RequestURI() != "/v1/payments/dp_sale/reversal-evidence" || r.Header.Get("Authorization") != "Bearer merchant" || r.Header.Get("Idempotency-Key") != "" {
+					t.Error("unexpected original evidence request", r.Method, r.URL.Path)
+					http.NotFound(w, r)
+					return
+				}
+				_ = json.NewEncoder(w).Encode(reply)
+			}))
+			defer httpProvider.Close()
+			adapter := DakimSimulator{base: httpProvider.URL, client: httpProvider.Client(), token: "merchant"}
+			proof, err := adapter.FullReversal(context.Background(), job)
+			if !tc.allow {
+				if err == nil || proof.Charge != "" || len(proof.Refunds) != 0 {
+					t.Fatal("accepted incomplete or misbound evidence", proof, err)
+				}
+				return
+			}
+			if err != nil || proof.Charge != "ch_test-sale" || len(proof.Refunds) != 2 || proof.Refunds[0] != (provedRefund{"dr_test_0", 100}) || proof.Refunds[1] != (provedRefund{"dr_test_1", 260}) {
+				t.Fatal(proof, err)
+			}
+		})
+	}
+}
