+func TestDakimOriginalCaptureRequiresCompleteRefundEvidence(t *testing.T) {
+	const base = `{"id":"dp_sale","merchant_id":"mimi","order_id":"MIMI-order","terminal_id":"MIMI-01","channel":"terminal","brand":"visa","amount":720,"currency":"USD","reference":"ch_sale","status":"captured"`
+	job := CardJob{ID: "order", Kind: "charge", Remote: "dp_sale", Amount: 720, Currency: "USD", Digits: 2, Merchant: "mimi", Provider: "dakim-simulator", Reader: "MIMI-01"}
+	for _, tc := range []struct {
+		name, suffix      string
+		success, reversed bool
+	}{
+		{"omitted", "}", false, false}, {"null", `,"refunded":null}`, false, false},
+		{"negative", `,"refunded":-1}`, false, false}, {"above capture", `,"refunded":721}`, false, false},
+		{"partial", `,"refunded":300}`, false, true}, {"full", `,"refunded":720}`, false, true},
+		{"zero", `,"refunded":0}`, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == "GET" && r.URL.Path == "/v1/payments/dp_sale/reversal-evidence" {
+					fmt.Fprint(w, `{"complete":true,"dispute_status":"none","refunds":[],"payment":`+base+tc.suffix+"}")
+					return
+				}
+				if r.Method != "GET" || r.URL.Path != "/v1/payments/dp_sale" {
+					http.Error(w, "unexpected operation", 400)
+					return
+				}
+				fmt.Fprint(w, base+tc.suffix)
+			}))
+			defer h.Close()
+			d := DakimSimulator{base: h.URL, client: h.Client()}
+			f, err := d.OriginalReference(context.Background(), job)
+			if (err == nil) != tc.success || (f.State == "succeeded") != tc.success || errors.Is(err, errReversedReference) != tc.reversed {
+				t.Fatalf("recovery evidence: %+v, %v", f, err)
+			}
+		})
+	}
+}
