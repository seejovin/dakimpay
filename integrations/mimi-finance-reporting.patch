diff --git a/webtest/refund-classification.cjs b/webtest/refund-classification.cjs
new file mode 100644
index 0000000..9ae3f9b
--- /dev/null
+++ b/webtest/refund-classification.cjs
@@ -0,0 +1,111 @@
+// Use the post-settlement refund fixture in a disposable Mimi installation.
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const { chromium } = require(process.env.PLAYWRIGHT_PATH || 'playwright');
+
+async function exercise() {
+  const origin = new URL(process.env.MIMI_UAT_URL);
+  assert.equal(origin.protocol, 'http:');
+  assert.equal(origin.hostname, '127.0.0.1');
+  const stage = process.env.MIMI_CLASSIFICATION_STAGE;
+  const id = process.env.MIMI_REFUND_ADJUSTMENT;
+  assert.ok(['eligible', 'approved', 'exercise'].includes(stage) && id);
+  const credentials = Object.fromEntries(fs.readFileSync(process.env.MIMI_UAT_CREDENTIALS, 'utf8').trim().split(/\r?\n/).map(line => line.split('\t')));
+  const browser = await chromium.launch({ executablePath: process.env.BROWSER_EXECUTABLE, headless: true });
+  const errors = [], commands = [];
+  async function operator(name) {
+    const page = await browser.newPage({ viewport: { width: 1440, height: 960 } });
+    page.on('pageerror', error => errors.push(error.message));
+    page.on('request', req => {
+      if (new URL(req.url()).pathname === '/api/command' && req.method() === 'POST') commands.push(req.postDataJSON().action);
+    });
+    await page.goto(origin.href);
+    assert.equal((await (await page.request.get(origin.origin + '/api/session')).json()).store.training, true);
+    await page.getByLabel('Username', { exact: true }).fill(name);
+    await page.getByLabel('Password', { exact: true }).fill(credentials[name]);
+    await page.getByRole('button', { name: 'Sign in', exact: true }).click();
+    await page.locator('#main-content').waitFor();
+    await page.goto(origin.origin + '/#reports');
+    await page.getByRole('heading', { name: 'Provider refunds after sale' }).waitFor();
+    return page;
+  }
+  const row = page => page.locator('#main-content tr').filter({ hasText: id });
+  const dialog = page => page.getByRole('dialog');
+  async function evidence(page) {
+    const response = await page.request.get(origin.origin + '/api/settlement/lookup?ref=' + encodeURIComponent(id));
+    assert.equal(response.status(), 200);
+    const matches = (await response.json()).providerRefunds.filter(r => r.id === id);
+    assert.equal(matches.length, 1);
+    return matches[0];
+  }
+  async function assertDetail(page, fact) {
+    const rendered = await dialog(page).innerText();
+    for (const value of [id, fact.receiptId, fact.original, fact.originalPayout, fact.originalBank,
+      fact.sourceReference, fact.debitBank, fact.debitPayout, fact.debitBatchId]) {
+      assert.ok(value && rendered.includes(value), 'Missing linked refund or bank evidence');
+    }
+    assert.equal(fact.amountMinor, 120);
+    assert.ok(rendered.includes('1.20') && rendered.includes('finance reports'));
+    if (fact.proposalId) {
+      for (const value of [fact.reason, fact.evidenceRef, fact.proposalId, fact.proposedBy]) {
+        assert.ok(value && rendered.includes(value), 'Missing classification proposal evidence');
+      }
+    }
+    if (fact.classificationStatus === 'approved') {
+      assert.ok(fact.approvedAt && fact.proposedAt && fact.proposedBy !== fact.approvedBy);
+      assert.ok(rendered.includes(fact.approvedBy) && rendered.includes('Approved at'));
+    }
+  }
+  async function findApproved(page) {
+    await page.reload();
+    await row(page).getByRole('button', { name: 'View classification' }).waitFor();
+    await page.getByRole('button', { name: 'Find statement or refund' }).click();
+    await dialog(page).getByRole('textbox').fill(id);
+    await dialog(page).getByRole('button', { name: 'Find', exact: true }).click();
+    await dialog(page).getByRole('button', { name: 'View classification' }).click();
+    await dialog(page).getByRole('heading', { name: 'Provider refund evidence' }).waitFor();
+    const fact = await evidence(page);
+    assert.equal(fact.classificationStatus, 'approved');
+    await assertDetail(page, fact);
+    assert.equal(await dialog(page).locator('button[type=submit]').count(), 0);
+  }
+  try {
+    // Mimi permits one active session per user. Keep the API exercise's
+    // finance and manager sessions active during the read-only checks.
+    const finance = await operator(stage === 'exercise' ? 'finance' : 'owner');
+    if (stage === 'approved') {
+      await findApproved(finance);
+    } else {
+      const initial = await evidence(finance);
+      assert.equal(initial.status, 'bank_matched');
+      assert.equal(initial.classificationStatus, 'unclassified');
+      await row(finance).getByRole('button', { name: 'Propose classification' }).click();
+      await dialog(finance).getByRole('heading', { name: 'Propose refund classification' }).waitFor();
+      await assertDetail(finance, initial);
+      if (stage === 'exercise') {
+        await dialog(finance).getByLabel('Business reason').fill('Customer care reviewed the merchant-funded service concession.');
+        await dialog(finance).getByLabel('Supporting evidence reference').fill('SERVICE/CASE-102');
+        await dialog(finance).getByRole('button', { name: 'Submit proposal' }).click();
+        await row(finance).getByRole('button', { name: 'View evidence' }).click();
+        await dialog(finance).getByText('Awaiting independent approval').waitFor();
+        assert.equal(await dialog(finance).locator('button[type=submit]').count(), 0);
+        const manager = await operator('manager');
+        await row(manager).getByRole('button', { name: 'Review proposal' }).click();
+        await dialog(manager).getByRole('heading', { name: 'Review refund classification' }).waitFor();
+        await assertDetail(manager, await evidence(manager));
+        await dialog(manager).getByRole('button', { name: 'Approve classification' }).click();
+        await row(manager).getByRole('button', { name: 'View classification' }).waitFor();
+        await findApproved(manager);
+      }
+    }
+    assert.deepEqual(commands, stage === 'exercise' ? [
+      'finance.settlement.classification.propose', 'finance.settlement.classification.approve',
+    ] : []);
+    assert.deepEqual(errors, []);
+    console.log('PASS finance browser ' + stage + ' · linked receipt, provider refund and both bank traces · classification controls and audit evidence');
+  } finally {
+    await browser.close();
+  }
+}
+
+exercise().catch(error => { console.error(error); process.exitCode = 1; });
