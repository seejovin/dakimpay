+// The same authenticated command can reach the store on independent connections.
+// Release both clients together and observe the HTTP results outside their goroutines.
+func retrySameCommand(t *testing.T, s *officeHTTPSession, action string, input map[string]any, key string) string {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{"action": action, "input": input})
+	if err != nil {
+		t.Fatal(err)
+	}
+	type reply struct {
+		id  string
+		err error
+	}
+	var replies [2]reply
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range replies {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req, e := http.NewRequest("POST", s.base+"/api/command", bytes.NewReader(body))
+			if e != nil {
+				replies[i].err = e
+				return
+			}
+			req.Header.Set("Origin", s.base)
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("X-CSRF-Token", s.csrf)
+			req.Header.Set("Idempotency-Key", key)
+			<-start
+			resp, e := s.client.Do(req)
+			if e != nil {
+				replies[i].err = e
+				return
+			}
+			defer resp.Body.Close()
+			var v struct {
+				Result struct{ ID string }
+				Error  string
+			}
+			e = json.NewDecoder(resp.Body).Decode(&v)
+			if e == nil && (resp.StatusCode != 200 || v.Result.ID == "") {
+				e = fmt.Errorf("status %d: %s", resp.StatusCode, v.Error)
+			}
+			replies[i] = reply{v.Result.ID, e}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if replies[0].err != nil || replies[1].err != nil || replies[0].id != replies[1].id {
+		t.Fatalf("concurrent %s replies: %+v", action, replies)
+	}
+	return replies[0].id
+}
+
+// A local HTTP supplier stores one capture before its confirmation is lost.
+// It subsequently serves incomplete evidence and an older, delayed observation.
+// Only the current worker with complete evidence may post the retail ledger.
+func TestDakimRegisterRecoveryFencesDelayedEvidence(t *testing.T) {
+	const paymentRef, refundRef = "dp_merchant_test", "dr_merchant_test"
+	type input = map[string]any
+	var chargeOperation, refundOperation atomic.Value
+	var createdChecks, refundChecks, captureWrites atomic.Int32
+	leaseWaiting, releaseLease := make(chan struct{}), make(chan struct{})
+	var unblock sync.Once
+	release := func() { unblock.Do(func() { close(releaseLease) }) }
+	acquirer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer 0123456789abcdef0123456789abcdef" {
+			http.Error(w, "unbound merchant", 403)
+			return
+		}
+		reply := func(v input) { w.Header().Set("Content-Type", "application/json"); _ = json.NewEncoder(w).Encode(v) }
+		charge := func() input {
+			return input{"id": paymentRef, "merchant_id": "mimi", "order_id": "MIMI-" + chargeOperation.Load().(string), "currency": "USD", "amount": 720, "channel": "terminal", "terminal_id": "MIMI-01", "brand": "visa", "status": "captured", "reference": "test_capture", "refunded": 0}
+		}
+		refund := func() input {
+			return input{"id": refundRef, "merchant_id": "mimi", "payment_id": paymentRef, "merchant_operation": refundOperation.Load().(string), "currency": "USD", "amount": 360, "status": "succeeded", "reference": "test_refund"}
+		}
+		switch r.Method + " " + r.URL.Path {
+		case "POST /v1/payments":
+			key := r.Header.Get("Idempotency-Key")
+			if chargeOperation.CompareAndSwap(nil, key) {
+				captureWrites.Add(1)
+				panic(http.ErrAbortHandler)
+			}
+			if key != chargeOperation.Load().(string) {
+				http.Error(w, "operation changed", 409)
+				return
+			}
+			reply(charge())
+		case "GET /v1/payments/" + paymentRef + "/reversal-evidence":
+			reply(input{"complete": true, "dispute_status": "none", "payment": charge(), "refunds": []input{}})
+		case "POST /v1/payments/" + paymentRef + "/recover":
+			v := charge()
+			switch createdChecks.Add(1) {
+			case 1:
+				delete(v, "refunded") // A captured label with incomplete proof.
+			case 2:
+				close(leaseWaiting)
+				<-releaseLease // An old response arrives after another lease posts the receipt.
+				v["status"] = "unknown"
+				v["reference"] = ""
+			}
+			reply(v)
+		case "POST /v1/payments/" + paymentRef + "/refunds":
+			key := r.Header.Get("Idempotency-Key")
+			refundOperation.CompareAndSwap(nil, key)
+			if key != refundOperation.Load().(string) {
+				http.Error(w, "refund operation changed", 409)
+				return
+			}
+			reply(refund())
+		case "POST /v1/refunds/" + refundRef + "/recover":
+			v := refund()
+			if refundChecks.Add(1) == 1 {
+				v["merchant_operation"] = "unrelated-refund-for-same-amount"
+			}
+			reply(v)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer acquirer.Close()
+	defer release()
+	tokenFile := filepath.Join(t.TempDir(), "merchant.key")
+	if err := os.WriteFile(tokenFile, []byte("0123456789abcdef0123456789abcdef"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("MIMI_CARD_MODE", "dakim-simulator")
+	t.Setenv("MIMI_DAKIM_URL", acquirer.URL)
+	t.Setenv("MIMI_DAKIM_TOKEN_FILE", tokenFile)
+	ctx := context.Background()
+	db, worker, staff, _ := officeHTTPStore(t, TrainingProfile())
+	// This fixture names the staffed till L1, while the enrolled demo store calls it Lane 1.
+	worker.Readers["L1"] = worker.Readers["Lane 1"]
+	cash, manager, fin := staff["cashier"], staff["supervisor"], staff["finance"]
+	check := func(want int64, sql string, args ...any) {
+		t.Helper()
+		var n int64
+		if err := db.QueryRow(ctx, sql, args...).Scan(&n); err != nil || n != want {
+			t.Fatalf("%s got %d, want %d: %v", sql, n, want, err)
+		}
+	}
+	due := func() {
+		t.Helper()
+		if _, err := db.Exec(ctx, `UPDATE card_attempt SET next_check=now(),lease_until=now()-interval '1 second' WHERE status IN ('queued','processing','unknown')`); err != nil {
+			t.Fatal(err)
+		}
+	}
+	step := func(c *CardService) {
+		t.Helper()
+		due()
+		if worked, err := c.Step(ctx); err != nil || !worked {
+			t.Fatalf("scheduled worker: %t, %v", worked, err)
+		}
+	}
+	basket := func() input {
+		return cash.request("GET", "/api/state?view=register", nil, "", 200)["commerce"].(input)["basket"].(input)
+	}
+	cash.command("commerce.open", input{}, "", 200)
+	for range 2 {
+		b := basket()
+		cash.command("commerce.add", input{"basketId": b["id"], "version": b["version"], "code": "EGGS"}, "", 200)
+	}
+	b := basket()
+	pay := input{"basketId": b["id"], "version": b["version"], "expectedTotalMinor": 720, "quoteKey": b["quoteKey"]}
+	key := newOfficeKey()
+	attempt := retrySameCommand(t, cash, "commerce.card.start", pay, key)
+	step(worker) // Provider committed; the response never arrived.
+	check(1, "SELECT count(*) FROM card_attempt WHERE id=$1 AND status='unknown' AND remote_id=''", attempt)
+	if cash.command("commerce.card.start", pay, key, 200)["id"] != attempt {
+		t.Fatal("lost-reply replay changed the attempt")
+	}
+	restarted, err := CardConfig(db, TrainingProfile().Store)
+	if err != nil {
+		t.Fatal(err)
+	}
+	step(restarted)
+	step(restarted)
+	step(restarted) // Rebind, dispatch, inspect incomplete evidence.
+	check(1, "SELECT count(*) FROM card_attempt WHERE id=$1 AND status='unknown'", attempt)
+	check(0, "SELECT count(*) FROM register_receipt WHERE basket_id=$1", b["id"])
+	due()
+	oldDone := make(chan error, 1)
+	go func() { _, err := worker.Step(ctx); oldDone <- err }()
+	select {
+	case <-leaseWaiting:
+	case <-time.After(5 * time.Second):
+		t.Fatal("older worker did not enter provider inspection")
+	}
+	step(restarted)
+	release()
+	if err := <-oldDone; err != nil {
+		t.Fatal(err)
+	}
+	var sale string
+	if err := db.QueryRow(ctx, "SELECT receipt_id FROM card_attempt WHERE id=$1 AND status='succeeded' AND remote_id=$2", attempt, paymentRef).Scan(&sale); err != nil {
+		t.Fatal(err)
+	}
+	if captureWrites.Load() != 1 {
+		t.Fatal("extra provider captures", captureWrites.Load())
+	}
+	check(1, "SELECT count(*) FROM register_receipt WHERE basket_id=$1", b["id"])
+	check(1, "SELECT count(*) FROM audit_log WHERE action='terminal.charge' AND object_id=$1", attempt)
+	check(720, "SELECT amount_minor FROM tender_journal WHERE source_id=$1 AND account='card_clearing'", sale)
+	check(0, "SELECT sum(amount_minor) FROM tender_journal WHERE source_id=$1", sale)
+	rid := retrySameCommand(t, cash, "commerce.refundRequest", input{"receiptId": sale, "sku": "EGGS", "qtyMilli": 1000, "reason": "Partial return after recovery"}, newOfficeKey())
+	cash.command("commerce.refundApprove", input{"refundId": rid}, "", 403)
+	retrySameCommand(t, manager, "commerce.refundApprove", input{"refundId": rid}, newOfficeKey())
+	step(restarted)
+	step(restarted) // Equal amount on another refund never authorizes this one.
+	check(1, "SELECT count(*) FROM register_refund WHERE id=$1 AND status='processing'", rid)
+	check(0, "SELECT count(*) FROM tender_journal WHERE source_id=$1", rid)
+	step(restarted)
+	check(1, "SELECT count(*) FROM card_attempt WHERE refund_id=$1 AND status='succeeded' AND remote_id=$2 AND original_ref=$3", rid, refundRef, paymentRef)
+	check(-360, "SELECT amount_minor FROM tender_journal WHERE source_id=$1 AND account='card_clearing'", rid)
+	check(0, "SELECT sum(amount_minor) FROM tender_journal WHERE source_id=$1", rid)
+	batch := fin.command("finance.settlement.import", input{"payout": "SIM-LEASE-P", "bank": "SIM-LEASE-B", "currency": "USD", "depositMinor": 346,
+		"lines": []input{{"reference": paymentRef, "grossMinor": 720, "feeMinor": 14}, {"reference": refundRef, "grossMinor": -360, "feeMinor": 0}}}, "", 200)["id"]
+	fin.command("finance.settlement.close", input{"id": batch}, "", 403)
+	retrySameCommand(t, manager, "finance.settlement.close", input{"id": batch}, newOfficeKey())
+	check(346, "SELECT amount_minor FROM settlement_journal WHERE batch_id=$1 AND account='bank'", batch)
+	check(14, "SELECT amount_minor FROM settlement_journal WHERE batch_id=$1 AND account='processing_fees'", batch)
+	check(-360, "SELECT amount_minor FROM settlement_journal WHERE batch_id=$1 AND account='card_clearing'", batch)
+	check(0, "SELECT sum(amount_minor) FROM settlement_journal WHERE batch_id=$1", batch)
+	check(0, "SELECT count(*) FROM unsettled_card")
+}
