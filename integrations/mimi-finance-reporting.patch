diff --git a/internal/server/refund_classification.go b/internal/server/refund_classification.go
new file mode 100644
index 0000000..32f3b47
--- /dev/null
+++ b/internal/server/refund_classification.go
@@ -0,0 +1,121 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/jackc/pgx/v5"
+	"mimi/internal/retail"
+)
+
+// The outer command persists a retry under its fresh request key, with an audit
+// outcome of replay. The original economic or reporting decision stays unique.
+type replayedCommandResult struct{ result any }
+
+// A historical request key may outlive the staff member's finance role.
+// Recheck reporting authority even when a saved operation satisfies the read.
+func classificationAccess(a retail.Actor, action string) error {
+	if strings.HasPrefix(action, "finance.settlement.classification.") && !requireAdmin(a) {
+		return retail.Fail(403, "Finance reporting permission required.")
+	}
+	return nil
+}
+
+func classificationResult(id, status string, inserted bool) any {
+	r := map[string]string{"id": id, "status": status}
+	if !inserted {
+		return replayedCommandResult{r}
+	}
+	return r
+}
+
+const concessionCategory = "merchant_funded_service_concession"
+
+func proposeRefundClassification(ctx context.Context, tx pgx.Tx, a retail.Actor, raw json.RawMessage) (any, error) {
+	var p struct{ ID, BatchID, Category, Reason, EvidenceRef string }
+	if err := parseInput(raw, &p); err != nil {
+		return nil, err
+	}
+	p.Reason = strings.TrimSpace(p.Reason)
+	if !statementRef.MatchString(p.ID) || !uuidRE.MatchString(p.BatchID) || p.Category != concessionCategory ||
+		utf8.RuneCountInString(p.Reason) < 4 || utf8.RuneCountInString(p.Reason) > 240 || strings.IndexFunc(p.Reason, unicode.IsControl) >= 0 ||
+		!statementRef.MatchString(p.EvidenceRef) {
+		return nil, retail.Fail(422, "Select the matched debit, service concession, a reason and an evidence reference.")
+	}
+	written, err := tx.Exec(ctx, `INSERT INTO provider_refund_classification_proposal(provider,merchant,adjustment_id,batch_id,category,reason,evidence_ref,proposed_by)
+	SELECT provider,merchant,adjustment_id,batch_id,$3,$4,$5,$6 FROM classifiable_refund_debit WHERE adjustment_id=$1 AND batch_id=$2
+	ON CONFLICT (provider,merchant,adjustment_id) DO NOTHING`, p.ID, p.BatchID, p.Category, p.Reason, p.EvidenceRef, a.ID)
+	if err != nil {
+		return nil, err
+	}
+	var id, status string
+	err = tx.QueryRow(ctx, `SELECT p.id,CASE WHEN ok.proposal_id IS NULL THEN 'pending_approval' ELSE 'approved' END
+	FROM provider_refund_classification_proposal p LEFT JOIN provider_refund_classification_approval ok ON ok.proposal_id=p.id
+	WHERE (p.adjustment_id,p.batch_id,p.category,p.reason,p.evidence_ref,p.proposed_by)=($1,$2,$3,$4,$5,$6)`,
+		p.ID, p.BatchID, p.Category, p.Reason, p.EvidenceRef, a.ID).Scan(&id, &status)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, retail.Fail(409, "A verified later bank debit and one unchanged proposal are required. Refresh the case.")
+	}
+	return classificationResult(id, status, written.RowsAffected() == 1), err
+}
+
+func approveRefundClassification(ctx context.Context, tx pgx.Tx, a retail.Actor, raw json.RawMessage) (any, error) {
+	var p struct{ ID, BatchID, ProposalID string }
+	if err := parseInput(raw, &p); err != nil {
+		return nil, err
+	}
+	if !statementRef.MatchString(p.ID) || !uuidRE.MatchString(p.BatchID) || !uuidRE.MatchString(p.ProposalID) {
+		return nil, retail.Fail(422, "Select the proposal tied to this matched bank debit.")
+	}
+	var proposer string
+	err := tx.QueryRow(ctx, `SELECT p.proposed_by FROM provider_refund_classification_proposal p
+	JOIN classifiable_refund_debit d USING(provider,merchant,adjustment_id,batch_id)
+	WHERE p.id=$1 AND p.adjustment_id=$2 AND p.batch_id=$3 FOR UPDATE OF p`, p.ProposalID, p.ID, p.BatchID).Scan(&proposer)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, retail.Fail(409, "The proposal must belong to this verified refund and bank debit.")
+	}
+	if err != nil {
+		return nil, err
+	}
+	if proposer == a.ID {
+		return nil, retail.Fail(403, "A different finance user, supervisor or owner must approve this classification.")
+	}
+	written, err := tx.Exec(ctx, `INSERT INTO provider_refund_classification_approval(proposal_id,approved_by)
+	VALUES($1,$2) ON CONFLICT(proposal_id) DO NOTHING`, p.ProposalID, a.ID)
+	if err != nil {
+		return nil, err
+	}
+	var same bool
+	err = tx.QueryRow(ctx, `SELECT approved_by=$2 FROM provider_refund_classification_approval WHERE proposal_id=$1`, p.ProposalID, a.ID).Scan(&same)
+	if err != nil {
+		return nil, err
+	}
+	if !same {
+		return nil, retail.Fail(409, "A different reviewer already approved this classification.")
+	}
+	return classificationResult(p.ProposalID, "approved", written.RowsAffected() == 1), nil
+}
+
+func providerRefundReport(ctx context.Context, tx pgx.Tx, actor, ref string) ([]map[string]any, error) {
+	return maps(ctx, tx, `SELECT n.adjustment_id id,n.payment_ref original,n.order_ref "orderRef",n.receipt_id "receiptId",
+ n.original_payout "originalPayout",n.original_bank "originalBank",n.source_ref "sourceReference",n.currency,n.amount_minor "amountMinor",n.occurred_at "occurredAt",
+ CASE WHEN n.debit_batch_id IS NOT NULL THEN 'bank_matched' WHEN n.original_batch_id IS NULL THEN 'review_original' ELSE 'awaiting_bank' END status,
+ n.debit_batch_id "debitBatchId",debit.bank_ref "debitBank",debit.payout_ref "debitPayout",
+ CASE WHEN ok.proposal_id IS NOT NULL THEN 'approved' WHEN p.id IS NOT NULL THEN 'pending_approval' ELSE 'unclassified' END "classificationStatus",
+ p.id "proposalId",p.category,p.reason,p.evidence_ref "evidenceRef",p.proposed_by "proposedBy",p.proposed_at "proposedAt",
+ ok.approved_by "approvedBy",ok.approved_at "approvedAt",proposer.name "proposedByName",approver.name "approvedByName",
+ d.batch_id IS NOT NULL AND p.id IS NULL "canPropose",
+ d.batch_id IS NOT NULL AND p.id IS NOT NULL AND ok.proposal_id IS NULL AND p.proposed_by<>$1 "canApprove"
+ FROM provider_refund_case n LEFT JOIN settlement_batch debit ON debit.id=n.debit_batch_id
+ LEFT JOIN classifiable_refund_debit d ON (d.provider,d.merchant,d.adjustment_id)=(n.provider,n.merchant,n.adjustment_id)
+ LEFT JOIN provider_refund_classification_proposal p ON (p.provider,p.merchant,p.adjustment_id)=(n.provider,n.merchant,n.adjustment_id)
+ LEFT JOIN provider_refund_classification_approval ok ON ok.proposal_id=p.id
+ LEFT JOIN staff proposer ON proposer.id=p.proposed_by LEFT JOIN staff approver ON approver.id=ok.approved_by
+ WHERE $2='' OR $2 IN (n.adjustment_id,n.payment_ref,n.receipt_id,n.source_ref,n.original_payout,n.original_bank,
+ n.debit_batch_id,debit.bank_ref,debit.payout_ref)
+ ORDER BY (n.debit_batch_id IS NULL) DESC,n.sequence_no DESC,n.provider,n.merchant LIMIT 100`, actor, ref)
+}
diff --git a/internal/server/refund_classification_test.go b/internal/server/refund_classification_test.go
new file mode 100644
index 0000000..f643b04
--- /dev/null
+++ b/internal/server/refund_classification_test.go
@@ -0,0 +1,192 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/url"
+	"reflect"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Build on the preceding test's actual register sale, posted original deposit,
+// provider notice, independent bank feed and finance closure of the subsequent debit.
+func verifyReportingClassification(t *testing.T, db *pgxpool.Pool, staff map[string]*officeHTTPSession, terms map[string]any, receipt, original, debit string) {
+	t.Helper()
+	const propose = "finance.settlement.classification.propose"
+	const approve = "finance.settlement.classification.approve"
+	fin, review, cash, other := staff["finance"], staff["owner-a"], staff["cashier"], staff["owner-b"]
+	ctx := context.Background()
+	count := func(want int, q string, args ...any) {
+		t.Helper()
+		var n int
+		if e := db.QueryRow(ctx, q, args...).Scan(&n); e != nil || n != want {
+			t.Fatalf("got %d, want %d: %s: %v", n, want, q, e)
+		}
+	}
+	fingerprint := func() string {
+		t.Helper()
+		var v string
+		err := db.QueryRow(ctx, `SELECT jsonb_build_array(
+		 (SELECT jsonb_agg(j ORDER BY j.source,j.source_id,j.account,j.amount_minor) FROM tender_journal j),
+		 (SELECT jsonb_agg(s ORDER BY s.batch_id,s.account) FROM settlement_journal s),
+		 (SELECT jsonb_agg(c ORDER BY c.id) FROM card_attempt c),
+		 (SELECT jsonb_agg(r ORDER BY r.id) FROM register_receipt r),
+		 (SELECT jsonb_agg(r ORDER BY r.id) FROM register_refund r),
+		 (SELECT jsonb_agg(n ORDER BY n.sequence_no) FROM provider_refund_notice n),
+		 (SELECT jsonb_agg(m ORDER BY m.id) FROM stock_move m),
+		 (SELECT jsonb_agg(s ORDER BY s.id) FROM settlement_batch s))::text`).Scan(&v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return v
+	}
+	caseRow := func(who *officeHTTPSession, ref string) map[string]any {
+		t.Helper()
+		result := who.request("GET", "/api/settlement/lookup?ref="+url.QueryEscape(ref), nil, "", 200)
+		rows := result["providerRefunds"].([]any)
+		if len(rows) != 1 {
+			t.Fatalf("refund lookup %s returned %d", ref, len(rows))
+		}
+		return rows[0].(map[string]any)
+	}
+	before := fingerprint()
+	row := caseRow(fin, receipt)
+	if row["canPropose"] != true || row["status"] != "bank_matched" || row["classificationStatus"] != "unclassified" {
+		t.Fatal(row)
+	}
+	cash.command(propose, terms, "", 403)
+	invalid := map[string]any{}
+	for k, v := range terms {
+		invalid[k] = v
+	}
+	invalid["category"] = "chargeback"
+	fin.command(propose, invalid, "", 422)
+	invalid["category"] = terms["category"]
+	invalid["batchId"] = original
+	fin.command(propose, invalid, "", 409)
+	id := retrySameCommand(t, fin, propose, terms, newOfficeKey())
+	again := fin.command(propose, terms, "", 200)
+	if again["id"] != id || again["status"] != "pending_approval" {
+		t.Fatal(again)
+	}
+	invalid["batchId"] = debit
+	invalid["reason"] = "Different business rationale"
+	fin.command(propose, invalid, "", 409)
+	other.command(propose, terms, "", 409)
+	row = caseRow(review, "bank-later")
+	if row["classificationStatus"] != "pending_approval" || row["canApprove"] != true || row["proposalId"] != id || row["canPropose"] != false || row["evidenceRef"] != terms["evidenceRef"] || caseRow(fin, "bank-later")["canApprove"] != false {
+		t.Fatal(row)
+	}
+	in := map[string]any{"id": terms["id"], "batchId": debit, "proposalId": id}
+	fin.command(approve, in, "", 403)
+	cash.command(approve, in, "", 403)
+	in["id"] = "different-refund"
+	review.command(approve, in, "", 409)
+	in["id"] = terms["id"]
+	in["proposalId"] = newOfficeKey()
+	review.command(approve, in, "", 409)
+	in["proposalId"] = id
+	in["batchId"] = original
+	review.command(approve, in, "", 409)
+	in["batchId"] = debit
+	review, approvalKey := raceClassificationReview(t, in, review, other)
+	if got := review.command(approve, in, approvalKey, 200)["id"]; got != id {
+		t.Fatal(got)
+	}
+	if retry := review.command(approve, in, "", 200); retry["status"] != "approved" || retry["id"] != id {
+		t.Fatal(retry)
+	}
+	state := caseRow(fin, "later")
+	if state["canApprove"] != false || state["canPropose"] != false || state["classificationStatus"] != "approved" || state["proposedBy"] == state["approvedBy"] || state["approvedByName"] == nil || state["reason"] != terms["reason"] || state["debitBank"] != "bank-later" || state["originalBank"] != "bank-first" {
+		t.Fatal(state)
+	}
+	for _, ref := range []string{receipt, "bank-first", "dr_external", debit} {
+		if !reflect.DeepEqual(state, caseRow(fin, ref)) {
+			t.Fatalf("report by %s did not bind same decision", ref)
+		}
+	}
+	count(1, "SELECT count(*) FROM provider_refund_classification_proposal")
+	count(1, "SELECT count(*) FROM provider_refund_classification_approval")
+	for _, ac := range []string{propose, approve} {
+		count(1, "SELECT count(*) FROM audit_log WHERE object_id=$1 AND action=$2 AND outcome='ok'", id, ac)
+		count(1, "SELECT count(*) FROM audit_log WHERE object_id=$1 AND action=$2 AND outcome='replay'", id, ac)
+	}
+	for _, q := range []string{
+		"UPDATE provider_refund_classification_proposal SET reason='Different evidence' WHERE id=$1",
+		"DELETE FROM provider_refund_classification_approval WHERE proposal_id=$1",
+		"UPDATE provider_refund_classification_approval SET approved_by=approved_by WHERE proposal_id=$1",
+	} {
+		if _, err := db.Exec(ctx, q, id); err == nil {
+			t.Fatalf("mutable decision: %s", q)
+		}
+	}
+	// A synthetic historical command record owned by today's cashier models a
+	// former reviewer without changing any access settings during the exercise.
+	staleKey := newOfficeKey()
+	encoded, err := json.Marshal(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec(ctx, `INSERT INTO operation(id,actor,lane,action,digest,result)
+	SELECT $1,id,lane,$2,$3,jsonb_build_object('id',$4::text,'status','approved') FROM staff WHERE username='cashier'`, staleKey, approve, hashText(approve+"\x00"+string(encoded)), id); err != nil {
+		t.Fatal(err)
+	}
+	cash.command(approve, in, staleKey, 403)
+	cash.request("GET", "/api/command/"+staleKey, nil, "", 403)
+	if after := fingerprint(); after != before {
+		t.Fatal("reporting action changed financial, stock or receipt evidence")
+	}
+}
+
+// Two independent reviewers submit different request keys against the same
+// pending decision. Only the winner may replay the success.
+func raceClassificationReview(t *testing.T, in map[string]any, first, second *officeHTTPSession) (*officeHTTPSession, string) {
+	t.Helper()
+	payload, err := json.Marshal(map[string]any{"action": "finance.settlement.classification.approve", "input": in})
+	if err != nil {
+		t.Fatal(err)
+	}
+	type reply struct {
+		reviewer *officeHTTPSession
+		key      string
+		status   int
+		err      error
+	}
+	done := make(chan reply, 2)
+	start := make(chan struct{})
+	for _, staff := range []*officeHTTPSession{first, second} {
+		req, err := http.NewRequest(http.MethodPost, staff.base+"/api/command", bytes.NewReader(payload))
+		if err != nil {
+			t.Fatal(err)
+		}
+		key := newOfficeKey()
+		req.Header.Set("Origin", staff.base)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-CSRF-Token", staff.csrf)
+		req.Header.Set("Idempotency-Key", key)
+		go func() {
+			<-start
+			result := reply{reviewer: staff, key: key}
+			resp, err := staff.client.Do(req)
+			if err == nil {
+				result.status = resp.StatusCode
+				resp.Body.Close()
+			}
+			result.err = err
+			done <- result
+		}()
+	}
+	close(start)
+	a, b := <-done, <-done
+	if a.status != 200 {
+		a, b = b, a
+	}
+	if a.err != nil || b.err != nil || a.status != 200 || b.status != 409 {
+		t.Fatalf("review race returned %d (%v) and %d (%v)", a.status, a.err, b.status, b.err)
+	}
+	return a.reviewer, a.key
+}
