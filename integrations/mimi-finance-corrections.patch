+-- A return is an independent, final review decision about a single proposal.
+-- New evidence forms a successor; existing proposals and approvals stay intact.
+CREATE TABLE provider_refund_classification_return (
+ proposal_id text PRIMARY KEY REFERENCES provider_refund_classification_proposal,
+ returned_by text NOT NULL REFERENCES staff, returned_at timestamptz NOT NULL DEFAULT now(),
+ reason text NOT NULL CHECK(char_length(reason) BETWEEN 4 AND 240 AND reason=btrim(reason) AND reason !~ '[[:cntrl:]]'),
+ evidence_ref text NOT NULL DEFAULT '' CHECK(evidence_ref='' OR evidence_ref ~ '^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$')
+);
+CREATE TRIGGER keep_refund_return BEFORE UPDATE OR DELETE ON provider_refund_classification_return
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
+
+ALTER TABLE provider_refund_classification_proposal
+ ADD COLUMN supersedes_id text REFERENCES provider_refund_classification_return(proposal_id),
+ ADD COLUMN revision integer NOT NULL DEFAULT 1 CHECK(revision>=1);
+
+-- 145 creates one unique case key, with a PostgreSQL-generated name. Replace
+-- it with one first revision per case and one successor per returned proposal.
+DO $$
+DECLARE old_name text;
+BEGIN
+ SELECT conname INTO STRICT old_name FROM pg_constraint
+ WHERE conrelid='provider_refund_classification_proposal'::regclass AND contype='u';
+ EXECUTE format('ALTER TABLE provider_refund_classification_proposal DROP CONSTRAINT %I',old_name);
+END $$;
+CREATE UNIQUE INDEX first_refund_classification_revision ON provider_refund_classification_proposal(provider,merchant,adjustment_id)
+ WHERE supersedes_id IS NULL;
+CREATE UNIQUE INDEX one_refund_classification_successor ON provider_refund_classification_proposal(supersedes_id)
+ WHERE supersedes_id IS NOT NULL;
+CREATE UNIQUE INDEX case_refund_classification_revision ON provider_refund_classification_proposal(provider,merchant,adjustment_id,revision);
+
+CREATE FUNCTION bind_refund_classification_revision() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE old_proposal provider_refund_classification_proposal%ROWTYPE;
+BEGIN
+ IF NEW.supersedes_id IS NULL THEN
+   NEW.revision:=1;
+ ELSE
+   SELECT p.* INTO old_proposal FROM provider_refund_classification_proposal p
+    JOIN provider_refund_classification_return r ON r.proposal_id=p.id
+    WHERE p.id=NEW.supersedes_id AND (p.provider,p.merchant,p.adjustment_id,p.batch_id) =
+     (NEW.provider,NEW.merchant,NEW.adjustment_id,NEW.batch_id);
+   IF NOT FOUND OR (old_proposal.reason,old_proposal.evidence_ref)=(NEW.reason,NEW.evidence_ref) THEN
+     RAISE EXCEPTION 'a corrected proposal requires the returned version of this same debit and corrected evidence or reason' USING ERRCODE='23514';
+   END IF;
+   NEW.revision:=old_proposal.revision+1;
+ END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER bind_refund_revision BEFORE INSERT ON provider_refund_classification_proposal
+ FOR EACH ROW EXECUTE FUNCTION bind_refund_classification_revision();
+
+-- Opposing decision inserts, even from concurrent database transactions, must
+-- claim the same primary key. The losing transaction rolls back its review.
+CREATE TABLE provider_refund_classification_decision (
+ proposal_id text PRIMARY KEY REFERENCES provider_refund_classification_proposal,
+ provider text NOT NULL, merchant text NOT NULL, adjustment_id text NOT NULL,
+ decision text NOT NULL CHECK(decision IN ('approved','returned'))
+);
+CREATE UNIQUE INDEX one_approved_refund_classification ON provider_refund_classification_decision(provider,merchant,adjustment_id)
+ WHERE decision='approved';
+INSERT INTO provider_refund_classification_decision(proposal_id,provider,merchant,adjustment_id,decision)
+ SELECT p.id,p.provider,p.merchant,p.adjustment_id,'approved'
+ FROM provider_refund_classification_approval a JOIN provider_refund_classification_proposal p ON p.id=a.proposal_id;
+CREATE TRIGGER keep_refund_decision BEFORE UPDATE OR DELETE ON provider_refund_classification_decision
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
+
+CREATE FUNCTION claim_refund_classification_decision() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE p provider_refund_classification_proposal%ROWTYPE;
+BEGIN
+ SELECT * INTO STRICT p FROM provider_refund_classification_proposal WHERE id=NEW.proposal_id;
+ IF TG_ARGV[0]='returned' THEN
+   IF NEW.returned_by=p.proposed_by OR NOT EXISTS(SELECT FROM staff WHERE id=NEW.returned_by AND active AND role IN ('finance','supervisor','owner'))
+   OR NOT EXISTS(SELECT FROM classifiable_refund_debit d WHERE (d.provider,d.merchant,d.adjustment_id,d.batch_id) =
+    (p.provider,p.merchant,p.adjustment_id,p.batch_id)) THEN
+     RAISE EXCEPTION 'return requires an independent authorized reviewer and a matched debit' USING ERRCODE='23514';
+   END IF;
+ END IF;
+ INSERT INTO provider_refund_classification_decision(proposal_id,provider,merchant,adjustment_id,decision)
+ VALUES(p.id,p.provider,p.merchant,p.adjustment_id,TG_ARGV[0]);
+ RETURN NULL;
+END $$;
+CREATE TRIGGER claim_refund_approval AFTER INSERT ON provider_refund_classification_approval
+ FOR EACH ROW EXECUTE FUNCTION claim_refund_classification_decision('approved');
+CREATE TRIGGER claim_refund_return AFTER INSERT ON provider_refund_classification_return
+ FOR EACH ROW EXECUTE FUNCTION claim_refund_classification_decision('returned');
+
+-- Reject an orphaned or misbound decision marker. The approval/return trigger
+-- runs after its source row was inserted, within the same transaction.
+CREATE FUNCTION check_refund_decision_source() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF NOT EXISTS(SELECT FROM provider_refund_classification_proposal p
+  WHERE (p.id,p.provider,p.merchant,p.adjustment_id)=(NEW.proposal_id,NEW.provider,NEW.merchant,NEW.adjustment_id))
+ OR (NEW.decision='approved' AND NOT EXISTS(SELECT FROM provider_refund_classification_approval WHERE proposal_id=NEW.proposal_id))
+ OR (NEW.decision='returned' AND NOT EXISTS(SELECT FROM provider_refund_classification_return WHERE proposal_id=NEW.proposal_id))
+ THEN RAISE EXCEPTION 'decision requires its original review' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER verify_refund_decision_source BEFORE INSERT ON provider_refund_classification_decision
+ FOR EACH ROW EXECUTE FUNCTION check_refund_decision_source();
+
+CREATE VIEW provider_refund_classification_version AS
+ SELECT p.provider,p.merchant,p.adjustment_id,p.id "proposalId",p.supersedes_id "supersedesId",p.revision,
+ p.category,p.reason,p.evidence_ref "evidenceRef",p.proposed_by "proposedBy",p.proposed_at "proposedAt",proposer.name "proposedByName",
+ coalesce(d.decision,'pending_approval') "classificationStatus",
+ a.approved_by "approvedBy",a.approved_at "approvedAt",approver.name "approvedByName",
+ r.returned_by "returnedBy",r.returned_at "returnedAt",reviewer.name "returnedByName",r.reason "returnReason",r.evidence_ref "returnEvidenceRef"
+ FROM provider_refund_classification_proposal p
+ LEFT JOIN provider_refund_classification_decision d ON d.proposal_id=p.id
+ LEFT JOIN provider_refund_classification_approval a ON a.proposal_id=p.id
+ LEFT JOIN provider_refund_classification_return r ON r.proposal_id=p.id
+ JOIN staff proposer ON proposer.id=p.proposed_by
+ LEFT JOIN staff approver ON approver.id=a.approved_by LEFT JOIN staff reviewer ON reviewer.id=r.returned_by;
