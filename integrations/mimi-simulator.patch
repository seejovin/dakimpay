diff --git a/internal/server/dakim_terminal.go b/internal/server/dakim_terminal.go
new file mode 100644
index 0000000..984a48c
--- /dev/null
+++ b/internal/server/dakim_terminal.go
@@ -0,0 +1,289 @@
+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// DakimSimulator connects an isolated training till to dakim pay over its merchant API.
+// The payment provider owns the acquirer operation and the till stores only provider references.
+type DakimSimulator struct {
+	base, token, brand string
+	client             *http.Client
+}
+type dakimEvidence struct {
+	ID, Status, Reference, Currency, Channel, Brand string
+	Merchant                                        string `json:"merchant_id"`
+	Order                                           string `json:"order_id"`
+	Terminal                                        string `json:"terminal_id"`
+	Original                                        string `json:"payment_id"`
+	Operation                                       string `json:"merchant_operation"`
+	Amount                                          int64
+	Refunded                                        *int64
+}
+
+func configureDakim(c *CardService, store Store) (*CardService, error) {
+	if !store.Training || store.Currency != "USD" || store.MinorDigits != 2 {
+		return nil, errors.New("dakim pay simulator requires a USD training store")
+	}
+	base := os.Getenv("MIMI_DAKIM_URL")
+	u, err := url.Parse(base)
+	if err != nil || u.Scheme != "http" || u.Hostname() != "127.0.0.1" || u.Port() == "" || u.Path != "" || u.RawQuery != "" || u.User != nil || u.Fragment != "" {
+		return nil, errors.New("dakim simulator requires an explicit local service origin")
+	}
+	path := os.Getenv("MIMI_DAKIM_TOKEN_FILE")
+	info, err := os.Stat(path)
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
+		return nil, errors.New("private dakim merchant credential required")
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	token := strings.TrimSpace(string(b))
+	if len(token) < 32 {
+		return nil, errors.New("invalid dakim merchant credential")
+	}
+	brand := os.Getenv("MIMI_DAKIM_TEST_BRAND")
+	if brand == "" {
+		brand = "visa"
+	}
+	if brand != "visa" && brand != "mastercard" && brand != "amex" {
+		return nil, errors.New("unknown simulated card brand")
+	}
+	c.Provider = "dakim-simulator"
+	c.Merchant = "mimi"
+	c.Readers = map[string]Reader{"Lane 1": {ID: "MIMI-01"}}
+	c.Adapter = &DakimSimulator{base: base, token: token, brand: brand, client: &http.Client{Timeout: 8 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}}
+	return c, nil
+}
+func (d *DakimSimulator) exchange(ctx context.Context, j CardJob, method, path, key string, body, out any) error {
+	if j.Merchant != "mimi" || j.Provider != "dakim-simulator" || j.Currency != "USD" || j.Digits != 2 || j.Amount <= 0 || j.Reader != "MIMI-01" {
+		return errors.New("invalid dakim merchant binding")
+	}
+	return d.call(ctx, method, path, key, body, out)
+}
+
+func (d *DakimSimulator) call(ctx context.Context, method, path, key string, body, out any) error {
+	var input bytes.Buffer
+	if body != nil {
+		if err := json.NewEncoder(&input).Encode(body); err != nil {
+			return err
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, d.base+path, &input)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Authorization", "Bearer "+d.token)
+	if method == "POST" {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	if key != "" {
+		req.Header.Set("Idempotency-Key", key)
+	}
+	resp, err := d.client.Do(req)
+	if err != nil {
+		return errors.New("dakim pay unavailable")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode/100 != 2 {
+		return fmt.Errorf("dakim pay returned HTTP %d", resp.StatusCode)
+	}
+	const limit = 1 << 20
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil {
+		return err
+	}
+	if len(raw) > limit {
+		return errors.New("dakim pay evidence exceeds the maximum response size")
+	}
+	if !uniqueJSON(raw) {
+		return errors.New("malformed or ambiguous dakim pay evidence")
+	}
+	return json.Unmarshal(raw, out)
+}
+func (d *DakimSimulator) request(ctx context.Context, j CardJob, method, path, key string, body any) (CardFact, error) {
+	var reply struct {
+		dakimEvidence
+		WireReference *string `json:"reference"`
+	}
+	if err := d.exchange(ctx, j, method, path, key, body, &reply); err != nil {
+		return CardFact{}, err
+	}
+	f := reply.dakimEvidence
+	if reply.WireReference != nil {
+		f.Reference = *reply.WireReference
+	}
+	prefix := "dp_"
+	if j.Kind == "refund" {
+		prefix = "dr_"
+	}
+	if !dakimOperationID(f.ID, prefix) || f.Merchant != j.Merchant || f.Amount != j.Amount || f.Currency != j.Currency || (j.Remote != "" && f.ID != j.Remote) {
+		return CardFact{}, errors.New("dakim pay evidence does not match the original operation")
+	}
+	result := CardFact{Remote: f.ID, State: "unknown"}
+	if j.Kind == "charge" {
+		if f.Order != "MIMI-"+j.ID || f.Channel != "terminal" || f.Terminal != j.Reader {
+			return CardFact{}, errors.New("dakim pay order or terminal mismatch")
+		}
+		// Only explicit, valid cumulative refund evidence can establish a spendable capture.
+		// A missing field in a partial or changed provider response must leave the till on hold.
+		if f.Refunded == nil || *f.Refunded < 0 || *f.Refunded > j.Amount {
+			return CardFact{}, errors.New("dakim pay refund total is missing or outside the captured amount")
+		}
+		if *f.Refunded > 0 {
+			return result, errReversedReference
+		}
+		if f.Status == "captured" && strings.TrimSpace(f.Reference) != "" {
+			j.Remote = f.ID
+			evidence, err := d.reversalEvidence(ctx, j)
+			if err != nil {
+				return result, err
+			}
+			if evidence.Payment.Reference != f.Reference || evidence.Payment.Brand != f.Brand {
+				return result, errors.New("dakim pay changed the original capture evidence")
+			}
+			if evidence.Dispute == "open" || len(evidence.Refunds) != 0 {
+				return result, errReversedReference
+			}
+			if evidence.Dispute != "none" {
+				return result, errUnprovenReversal
+			}
+			result.State = "succeeded"
+		}
+	} else {
+		if f.Original != j.Original || f.Operation != j.ID {
+			return CardFact{}, errors.New("dakim pay refund parent or operation mismatch")
+		}
+		if f.Status == "succeeded" && strings.TrimSpace(f.Reference) != "" {
+			result.State = "succeeded"
+		} else if f.Status == "declined" && reply.WireReference != nil && f.Reference == "" {
+			// The provider records a definitive refusal against this exact request.
+			result.State = "declined"
+		}
+	}
+	return result, nil
+}
+func (d *DakimSimulator) Create(ctx context.Context, j CardJob) (CardFact, error) {
+	if j.Kind == "refund" {
+		if !dakimOperationID(j.Original, "dp_") {
+			return CardFact{}, errors.New("invalid original payment")
+		}
+		return d.request(ctx, j, "POST", "/v1/payments/"+j.Original+"/refunds", j.ID, map[string]any{"amount": j.Amount})
+	}
+	return d.request(ctx, j, "POST", "/v1/payments", j.ID, map[string]any{"order_id": "MIMI-" + j.ID, "channel": "terminal", "terminal_id": j.Reader, "amount": j.Amount, "currency": j.Currency, "brand": d.brand, "lose_response": true})
+}
+
+// An accepted create already presented the synthetic card. Dispatch has no second financial effect.
+func (d *DakimSimulator) Dispatch(_ context.Context, _ CardJob) error { return nil }
+func (d *DakimSimulator) lookup(ctx context.Context, j CardJob, recover bool) (CardFact, error) {
+	if !safeRemoteID.MatchString(j.Remote) {
+		return CardFact{}, errors.New("missing original dakim pay reference")
+	}
+	resource := "/v1/payments/"
+	if j.Kind == "refund" {
+		resource = "/v1/refunds/"
+	}
+	path := resource + j.Remote
+	method := "GET"
+	if recover {
+		path += "/recover"
+		method = "POST"
+	}
+	return d.request(ctx, j, method, path, "", nil)
+}
+func (d *DakimSimulator) Inspect(ctx context.Context, j CardJob) (CardFact, error) {
+	return d.lookup(ctx, j, true)
+}
+func (d *DakimSimulator) OriginalReference(ctx context.Context, j CardJob) (CardFact, error) {
+	return d.lookup(ctx, j, false)
+}
+
+// Synthetic taps capture immediately. Resolve the original operation before authorizing the till to release a basket.
+func (d *DakimSimulator) Cancel(ctx context.Context, j CardJob) (CardFact, error) {
+	return d.Inspect(ctx, j)
+}
+
+func dakimOperationID(value, prefix string) bool {
+	return len(value) > len(prefix) && len(value) <= 128 && strings.HasPrefix(value, prefix) && safeRemoteID.MatchString(value)
+}
+
+var dakimSourceID = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)
+
+type dakimRefundLeg struct {
+	dakimEvidence
+	Charge string `json:"charge_reference"`
+}
+
+type dakimReversal struct {
+	Payment  dakimEvidence
+	Refunds  []dakimRefundLeg
+	Complete bool
+	Dispute  string `json:"dispute_status"`
+}
+
+// Read a single merchant snapshot verified against the acquirer, including refund
+// reservations that would not appear in the captured payment's cumulative total.
+func (d *DakimSimulator) reversalEvidence(ctx context.Context, j CardJob) (dakimReversal, error) {
+	var v dakimReversal
+	if j.Kind != "charge" || !dakimOperationID(j.Remote, "dp_") {
+		return v, errUnprovenReversal
+	}
+	if err := d.exchange(ctx, j, "GET", "/v1/payments/"+j.Remote+"/reversal-evidence", "", nil, &v); err != nil {
+		return dakimReversal{}, err
+	}
+	p := v.Payment
+	if !v.Complete || v.Refunds == nil || (v.Dispute != "none" && v.Dispute != "open" && v.Dispute != "unknown") ||
+		p.ID != j.Remote || p.Merchant != j.Merchant || p.Order != "MIMI-"+j.ID || p.Channel != "terminal" || p.Terminal != j.Reader ||
+		(p.Brand != "visa" && p.Brand != "mastercard" && p.Brand != "amex") || p.Status != "captured" ||
+		!dakimSourceID.MatchString(p.Reference) || p.Amount != j.Amount || p.Currency != j.Currency || p.Refunded == nil {
+		return dakimReversal{}, errUnprovenReversal
+	}
+	seenRefund := make(map[string]bool, len(v.Refunds))
+	seenReference := map[string]bool{p.Reference: true}
+	seenOperation := make(map[string]bool, len(v.Refunds))
+	var total int64
+	for _, r := range v.Refunds {
+		if !dakimOperationID(r.ID, "dr_") || seenRefund[r.ID] ||
+			!dakimSourceID.MatchString(r.Reference) || seenReference[r.Reference] || !dakimSourceID.MatchString(r.Operation) || seenOperation[r.Operation] ||
+			r.Status != "succeeded" || r.Merchant != p.Merchant || r.Original != p.ID || r.Charge != p.Reference ||
+			r.Currency != p.Currency || r.Amount <= 0 || r.Amount > p.Amount-total {
+			return dakimReversal{}, errUnprovenReversal
+		}
+		seenRefund[r.ID] = true
+		seenReference[r.Reference] = true
+		seenOperation[r.Operation] = true
+		total += r.Amount
+	}
+	if *p.Refunded != total {
+		return dakimReversal{}, errUnprovenReversal
+	}
+	return v, nil
+}
+
+func (d *DakimSimulator) FullReversal(ctx context.Context, j CardJob) (reversalProof, error) {
+	v, err := d.reversalEvidence(ctx, j)
+	if err != nil {
+		return reversalProof{}, err
+	}
+	if v.Dispute != "none" || *v.Payment.Refunded != j.Amount {
+		return reversalProof{}, errUnprovenReversal
+	}
+	proof := reversalProof{Charge: v.Payment.Reference}
+	for _, r := range v.Refunds {
+		// Mimi's merchant statement identifies refunds by the dakim operation ID.
+		proof.Refunds = append(proof.Refunds, provedRefund{r.ID, r.Amount})
+	}
+	return proof, nil
+}
