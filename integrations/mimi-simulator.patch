+func TestProviderRefundRequiresOriginalReceiptAndLaterPostedDebit(t *testing.T) {
+	type fields = map[string]any
+	ctx := context.Background()
+	db, cards, users, _ := officeHTTPStore(t, TrainingProfile())
+	cash, fin, review := users["cashier"], users["finance"], users["owner-a"]
+	fixture := &adjustmentFixture{Terminal: cards.Adapter}
+	cards.Adapter = fixture
+	basket := func() fields {
+		return cash.request("GET", "/api/state?view=register", nil, "", 200)["commerce"].(fields)["basket"].(fields)
+	}
+	cash.command("commerce.open", fields{}, "", 200)
+	b := basket()
+	cash.command("commerce.add", fields{"basketId": b["id"], "version": b["version"], "code": "EGGS"}, "", 200)
+	b = basket()
+	id := cash.command("commerce.card.start", fields{"basketId": b["id"], "version": b["version"], "expectedTotalMinor": 360, "quoteKey": b["quoteKey"]}, "", 200)["id"].(string)
+	for range 3 {
+		if _, e := db.Exec(ctx, "UPDATE card_attempt SET next_check=now() WHERE id=$1", id); e != nil {
+			t.Fatal(e)
+		}
+		if did, e := cards.Step(ctx); e != nil || !did {
+			t.Fatal(did, e)
+		}
+	}
+	var remote, receipt string
+	if e := db.QueryRow(ctx, "SELECT remote_id,receipt_id FROM card_attempt WHERE id=$1 AND status='succeeded'", id).Scan(&remote, &receipt); e != nil {
+		t.Fatal(e)
+	}
+	open := func(payout, bank string, deposit int, lines ...statementLine) string {
+		t.Helper()
+		return fin.command("finance.settlement.import", fields{"payout": payout, "bank": bank, "currency": "USD", "depositMinor": deposit, "lines": lines}, "", 200)["id"].(string)
+	}
+	close := func(id string, expect int) {
+		t.Helper()
+		review.command("finance.settlement.close", fields{"id": id}, "", expect)
+	}
+	void := func(id string) {
+		t.Helper()
+		review.command("finance.settlement.void", fields{"id": id, "reason": "Incorrect candidate statement"}, "", 200)
+	}
+	first := open("first", "bank-first", 353, statementLine{Reference: remote, Gross: 360, Fee: 7})
+	close(first, 200)
+	originalNet := int64(353)
+	fixture.notice = providerRefund{Sequence: 1, Kind: "provider_refund", ID: "dr_external", Payment: remote, Order: "merchant-receipt", attempt: id, Merchant: cards.Merchant, Charge: "origin_charge", SourceOperation: "provider_operation", Reference: "refund_ref", Amount: 120, Currency: "USD", OriginalPayout: "first", OriginalBank: "bank-first", OriginalDeposit: &originalNet, Occurred: time.Now().UTC()}
+	var workers sync.WaitGroup
+	for range 4 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if e := cards.collectProviderRefunds(ctx, fixture); e != nil {
+				t.Error(e)
+			}
+		}()
+	}
+	workers.Wait()
+	count := func(expected int, query string, args ...any) {
+		t.Helper()
+		var v int
+		if e := db.QueryRow(ctx, query, args...).Scan(&v); e != nil || v != expected {
+			t.Fatalf("%s got %d expected %d: %v", query, v, expected, e)
+		}
+	}
+	count(1, "SELECT count(*) FROM provider_refund_case WHERE receipt_id=$1 AND original_batch_id=$2 AND debit_batch_id IS NULL", receipt, first)
+
+	fixture.notice.Sequence = 2
+	fixture.notice.Amount++
+	if err := cards.collectProviderRefunds(ctx, fixture); err == nil {
+		t.Fatal("same provider adjustment was accepted with different money")
+	}
+	fixture.notice.Sequence = 1
+	fixture.notice.Amount--
+	count(1, "SELECT count(*) FROM provider_refund_notice")
+
+	leg := statementLine{Reference: "dr_external", Original: remote, Kind: "provider_refund", Gross: -120}
+	bad := leg
+	bad.Kind = "chargeback"
+	disguised := open("incorrect", "bank-wrong", -120, bad)
+	close(disguised, 409)
+	void(disguised)
+	fake := open("later", "some-other-bank", -120, leg)
+	amount := int64(-120)
+	fixture.statement = providerStatement{Payout: "later", Bank: "bank-later", Currency: "USD", Deposit: &amount, Lines: []statementLine{leg}}
+	fixture.posted = true
+	if e := cards.checkProviderStatement(ctx, fixture); e != nil {
+		t.Fatal(e)
+	}
+	close(fake, 409)
+	void(fake)
+	fixture.posted = false
+	debit := open("later", "bank-later", -120, leg)
+	if e := cards.checkProviderStatement(ctx, fixture); e != nil {
+		t.Fatal(e)
+	}
+	close(debit, 409)
+	count(0, "SELECT count(*) FROM provider_refund_applied")
+	count(0, "SELECT count(*) FROM settlement_journal WHERE batch_id=$1", debit)
+	fixture.posted = true
+	if _, e := db.Exec(ctx, "UPDATE provider_statement_check SET next_check=now() WHERE batch_id=$1", debit); e != nil {
+		t.Fatal(e)
+	}
+	if e := cards.checkProviderStatement(ctx, fixture); e != nil {
+		t.Fatal(e)
+	}
+	if _, err := db.Exec(ctx, "INSERT INTO settlement_line(batch_id,remote_id,gross_minor,fee_minor) VALUES($1,'additional',1,0)", debit); err == nil {
+		t.Fatal("additional line accepted after bank evidence")
+	}
+	if _, err := db.Exec(ctx, "UPDATE settlement_batch SET bank_ref='different-bank' WHERE id=$1", debit); err == nil {
+		t.Fatal("verified bank trace was mutable")
+	}
+	fin.command("finance.settlement.close", fields{"id": debit}, "", 403)
+	retrySameCommand(t, review, "finance.settlement.close", fields{"id": debit}, newOfficeKey())
+	close(debit, 409)
+	if e := cards.collectProviderRefunds(ctx, fixture); e != nil {
+		t.Fatal(e)
+	}
+	count(1, "SELECT count(*) FROM provider_refund_notice")
+	count(1, "SELECT count(*) FROM provider_refund_case WHERE debit_batch_id=$1 AND receipt_id=$2", debit, receipt)
+	count(-120, "SELECT amount_minor FROM settlement_journal WHERE account='bank' AND batch_id=$1", debit)
+	count(120, "SELECT amount_minor FROM settlement_journal WHERE account='provider_refund_suspense' AND batch_id=$1", debit)
+	count(353, "SELECT amount_minor FROM settlement_journal WHERE account='bank' AND batch_id=$1", first)
+	count(1, "SELECT count(*) FROM register_receipt")
+	count(0, "SELECT count(*) FROM register_refund")
+	count(0, "SELECT count(*) FROM settlement_journal s WHERE s.batch_id=$1 AND s.account NOT IN ('bank','provider_refund_suspense')", debit)
+	// An actual later retail return must respect the original card balance.
+	// The clerk can record a request, but $3.60 can no longer be refunded.
+	request := cash.command("commerce.refundRequest", fields{"receiptId": receipt, "sku": "EGGS", "qtyMilli": 1000, "reason": "Original goods brought back after provider refund"}, "", 200)["id"]
+	review.command("commerce.refundApprove", fields{"refundId": request}, "", 409)
+	count(0, "SELECT count(*) FROM card_attempt WHERE kind='refund'")
+	count(1, "SELECT count(*) FROM provider_refund_applied")
+
+}
