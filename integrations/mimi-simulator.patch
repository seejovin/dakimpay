+func TestDakimUnknownRefundHoldsFirstCreateAcrossReplayWindow(t *testing.T) {
+	const token = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	var order atomic.Value
+	var creates atomic.Int32
+	var evidence atomic.Value
+	evidence.Store("pending")
+	acq := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer "+token {
+			http.Error(w, "wrong credential", 403)
+			return
+		}
+		switch r.Method + " " + r.URL.Path {
+		case "POST /v1/payments":
+			creates.Add(1)
+			order.Store(r.Header.Get("Idempotency-Key"))
+			_ = json.NewEncoder(w).Encode(testDakimReversal(order.Load().(string), 0, 0)["payment"])
+		case "POST /v1/payments/dp_sale/recover":
+			// Older summary still reports a clean capture while the independent snapshot has advanced.
+			_ = json.NewEncoder(w).Encode(testDakimReversal(order.Load().(string), 0, 0)["payment"])
+		case "GET /v1/payments/dp_sale/reversal-evidence":
+			if evidence.Load() == "pending" {
+				http.Error(w, "refund reservation pending", 409)
+				return
+			}
+			v := testDakimReversal(order.Load().(string), 0, 0)
+			v["dispute_status"] = evidence.Load().(string)
+			if evidence.Load() == "full" {
+				v = testDakimReversal(order.Load().(string), 100, 260)
+			}
+			_ = json.NewEncoder(w).Encode(v)
+		default:
+			t.Errorf("unexpected operation %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer acq.Close()
+	tokenFile := filepath.Join(t.TempDir(), "merchant.key")
+	if err := os.WriteFile(tokenFile, []byte(token), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("MIMI_CARD_MODE", "dakim-simulator")
+	t.Setenv("MIMI_DAKIM_URL", acq.URL)
+	t.Setenv("MIMI_DAKIM_TOKEN_FILE", tokenFile)
+	ctx := context.Background()
+	db, worker, staff, _ := officeHTTPStore(t, TrainingProfile())
+	worker.Readers["L1"] = worker.Readers["Lane 1"]
+	cash, owner, finance := staff["cashier"], staff["owner-a"], staff["finance"]
+	step := func() {
+		t.Helper()
+		if _, err := db.Exec(ctx, `UPDATE card_attempt SET next_check=now() WHERE status IN ('queued','unknown','processing')`); err != nil {
+			t.Fatal(err)
+		}
+		if did, err := worker.Step(ctx); !did || err != nil {
+			t.Fatal(did, err)
+		}
+	}
+	cash.command("commerce.open", dakimTestFields{}, "", 200)
+	basket := func() dakimTestFields {
+		return cash.request("GET", "/api/state?view=register", nil, "", 200)["commerce"].(dakimTestFields)["basket"].(dakimTestFields)
+	}
+	b := basket()
+	cash.command("commerce.add", dakimTestFields{"basketId": b["id"], "version": b["version"], "code": "EGGS"}, "", 200)
+	b = basket()
+	id := cash.command("commerce.card.start", dakimTestFields{"basketId": b["id"], "version": b["version"], "quoteKey": b["quoteKey"], "expectedTotalMinor": 360}, "", 200)["id"]
+	stage := func(want string) {
+		t.Helper()
+		var got, remote string
+		var receipted bool
+		if err := db.QueryRow(ctx, `SELECT stage,remote_id,receipt_id IS NOT NULL FROM card_attempt WHERE id=$1`, id).Scan(&got, &remote, &receipted); err != nil || got != want || remote != "dp_sale" || receipted {
+			t.Fatal(got, remote, receipted, err)
+		}
+	}
+	step()
+	stage("inspect")
+	if _, err := db.Exec(ctx, `UPDATE card_attempt SET created_at=now()-interval '21 hours' WHERE id=$1`, id); err != nil {
+		t.Fatal(err)
+	}
+	step()
+	stage("inspect")
+	evidence.Store("unknown")
+	step()
+	stage("inspect")
+	evidence.Store("open")
+	step()
+	stage("reversal_review")
+	decision := dakimTestFields{"id": id, "evidence": "Eggs physically present in marked hold bin"}
+	finance.command("commerce.card.reversalApprove", decision, "", 409)
+	owner.command("commerce.card.reversalCustody", decision, "", 200)
+	owner.command("commerce.card.reversalApprove", decision, "", 403)
+	finance.command("commerce.card.reversalApprove", decision, "", 200)
+	step()
+	stage("reversal_finance")
+	evidence.Store("full")
+	finance.command("commerce.card.reversalApprove", decision, "", 200)
+	step()
+	stage("externally_refunded")
+	var legs int
+	var gross int64
+	if err := db.QueryRow(ctx, `SELECT count(*),sum(gross_minor) FROM external_card_reversal_leg WHERE attempt_id=$1 AND charge_ref='ch_test-sale'`, id).Scan(&legs, &gross); err != nil || legs != 3 || gross != 0 || creates.Load() != 1 {
+		t.Fatal(legs, gross, creates.Load(), err)
+	}
