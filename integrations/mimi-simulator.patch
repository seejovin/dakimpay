diff --git a/migrations/135_provider_refunds.sql b/migrations/135_provider_refunds.sql
new file mode 100644
index 0000000..97ad6f4
--- /dev/null
+++ b/migrations/135_provider_refunds.sql
@@ -0,0 +1,107 @@
+-- Evidence of money returned after a receipted sale. The provider refund does
+-- not establish which items came back or how tax and stock should be treated.
+CREATE TABLE provider_refund_notice (
+ provider text NOT NULL, merchant text NOT NULL, sequence_no bigint NOT NULL CHECK(sequence_no>0),
+ adjustment_id text NOT NULL, payment_ref text NOT NULL, order_ref text NOT NULL, attempt_ref text NOT NULL,
+ charge_ref text NOT NULL, source_operation text NOT NULL, source_ref text NOT NULL,
+ amount_minor bigint NOT NULL CHECK(amount_minor>0), currency text NOT NULL,
+ original_payout text NOT NULL, original_bank text NOT NULL, original_deposit_minor bigint NOT NULL, occurred_at timestamptz NOT NULL, observed_at timestamptz NOT NULL DEFAULT now(),
+ PRIMARY KEY(provider,merchant,adjustment_id), UNIQUE(provider,merchant,sequence_no),
+ UNIQUE(provider,merchant,source_operation), UNIQUE(provider,merchant,source_ref)
+);
+CREATE INDEX provider_refund_original ON provider_refund_notice(provider,merchant,payment_ref);
+CREATE TRIGGER retain_provider_refund BEFORE UPDATE OR DELETE ON provider_refund_notice
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
+
+-- The intake verifies the provider's matched statement outside the till writer
+-- lock. A finance user may import a candidate before the evidence is available.
+CREATE TABLE provider_statement_check (
+ batch_id text PRIMARY KEY REFERENCES settlement_batch,
+ next_check timestamptz NOT NULL DEFAULT now(), verified_at timestamptz,
+ last_message text NOT NULL DEFAULT 'Awaiting independent bank evidence'
+);
+-- Seal all lines and financial terms as soon as the candidate is imported.
+-- Finance can void an incorrect import and enter a corrected statement.
+CREATE OR REPLACE FUNCTION check_statement_open() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ PERFORM 1 FROM settlement_batch WHERE id=NEW.batch_id AND status='open' FOR SHARE;
+ IF NOT FOUND OR EXISTS(SELECT FROM provider_statement_check WHERE batch_id=NEW.batch_id)
+ THEN RAISE EXCEPTION 'statement lines are sealed' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+CREATE FUNCTION protect_imported_payout() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF (NEW.provider,NEW.merchant,NEW.payout_ref,NEW.currency,NEW.deposit_minor,NEW.bank_ref,NEW.created_by)
+ IS DISTINCT FROM (OLD.provider,OLD.merchant,OLD.payout_ref,OLD.currency,OLD.deposit_minor,OLD.bank_ref,OLD.created_by)
+ AND EXISTS(SELECT FROM provider_statement_check WHERE batch_id=OLD.id)
+ THEN RAISE EXCEPTION 'imported payout terms are sealed' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER keep_verified_statement_terms BEFORE UPDATE ON settlement_batch
+ FOR EACH ROW EXECUTE FUNCTION protect_imported_payout();
+
+CREATE TABLE provider_refund_applied (
+ provider text NOT NULL, merchant text NOT NULL, adjustment_id text NOT NULL,
+ batch_id text NOT NULL REFERENCES settlement_batch, PRIMARY KEY(provider,merchant,adjustment_id),
+ FOREIGN KEY(provider,merchant,adjustment_id) REFERENCES provider_refund_notice(provider,merchant,adjustment_id),
+ FOREIGN KEY(batch_id,adjustment_id) REFERENCES settlement_line(batch_id,remote_id)
+);
+CREATE TRIGGER retain_provider_refund_match BEFORE UPDATE OR DELETE ON provider_refund_applied
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
+
+ALTER TABLE settlement_line DROP CONSTRAINT settlement_line_entry_kind_check,
+ ADD CHECK(entry_kind IN ('transaction','fee','chargeback','chargeback_reversal','reserve_hold','reserve_release','provider_refund')),
+ ADD CHECK(entry_kind<>'provider_refund' OR (gross_minor<0 AND original_ref<>''));
+
+CREATE VIEW provider_refund_case AS
+ SELECT n.*,c.receipt_id, b.id AS original_batch_id,ap.batch_id AS debit_batch_id
+ FROM provider_refund_notice n
+ LEFT JOIN card_attempt c ON (c.provider,c.merchant,c.id,c.remote_id,c.currency) =
+ (n.provider,n.merchant,n.attempt_ref,n.payment_ref,n.currency)
+ AND c.kind='charge' AND c.status='succeeded' AND c.receipt_id IS NOT NULL
+ AND c.amount_minor >= (SELECT sum(other.amount_minor) FROM provider_refund_notice other
+  WHERE (other.provider,other.merchant,other.payment_ref)=(n.provider,n.merchant,n.payment_ref)
+  AND other.sequence_no<=n.sequence_no) + (SELECT coalesce(sum(r.amount_minor),0) FROM card_attempt r
+  WHERE (r.provider,r.merchant,r.original_ref,r.currency)=(n.provider,n.merchant,n.payment_ref,n.currency)
+  AND r.kind='refund' AND r.status='succeeded')
+ LEFT JOIN settlement_applied s ON s.attempt_id=c.id AND s.remote_id=n.payment_ref
+ LEFT JOIN settlement_batch b ON b.id=s.batch_id AND b.status='closed' AND b.provider=n.provider
+ AND b.merchant=n.merchant AND b.currency=n.currency AND b.bank_ref=n.original_bank AND b.deposit_minor=n.original_deposit_minor AND EXISTS(SELECT FROM settlement_evidence p
+ WHERE p.batch_id=b.id AND p.evidence_type='payout' AND p.reference=n.original_payout)
+ LEFT JOIN provider_refund_applied ap ON (ap.provider,ap.merchant,ap.adjustment_id)=(n.provider,n.merchant,n.adjustment_id);
+
+ALTER VIEW settlement_match RENAME TO settlement_before_provider_refunds;
+CREATE VIEW settlement_match AS
+ SELECT m.batch_id,m.remote_id,m.gross_minor,m.fee_minor,m.attempt_id,
+ CASE WHEN n.adjustment_id IS NOT NULL THEN -n.amount_minor ELSE m.expected_minor END expected_minor,
+ CASE WHEN n.adjustment_id IS NOT NULL AND m.entry_kind<>'provider_refund' THEN 'provider refund classified incorrectly'
+ WHEN chk.batch_id IS NOT NULL AND chk.verified_at IS NULL THEN chk.last_message
+ WHEN m.entry_kind<>'provider_refund' THEN m.result
+ WHEN n.adjustment_id IS NULL OR n.original_batch_id IS NULL THEN 'verified provider refund or original settled receipt missing'
+ WHEN n.currency<>b.currency OR n.payment_ref<>m.original_ref OR m.gross_minor<>-n.amount_minor THEN 'provider refund terms differ'
+ WHEN chk.verified_at IS NULL THEN 'independent bank evidence missing'
+ WHEN n.debit_batch_id IS NOT NULL AND n.debit_batch_id<>b.id THEN 'already reconciled'
+ WHEN m.result<>'matched' THEN m.result ELSE 'matched' END result,
+ m.entry_kind,m.original_ref,m.payout_ref,m.external_reversal
+ FROM settlement_before_provider_refunds m JOIN settlement_batch b ON b.id=m.batch_id
+ LEFT JOIN provider_refund_case n ON (n.provider,n.merchant,n.adjustment_id)=(b.provider,b.merchant,m.remote_id)
+ LEFT JOIN provider_statement_check chk ON chk.batch_id=b.id;
+
+CREATE OR REPLACE FUNCTION post_settlement(batch_key text) RETURNS void LANGUAGE plpgsql AS $$
+DECLARE residual numeric;
+BEGIN
+ INSERT INTO settlement_journal(batch_id,account,amount_minor)
+ SELECT batch_key,account,sum(amount)::bigint FROM (
+   SELECT 'bank' AS account,deposit_minor AS amount FROM settlement_batch WHERE id=batch_key AND status='closed'
+   UNION ALL SELECT 'processing_fees',fee_minor FROM settlement_line WHERE batch_id=batch_key
+   UNION ALL SELECT CASE l.entry_kind
+     WHEN 'transaction' THEN CASE WHEN e.batch_id IS NULL THEN 'card_clearing' ELSE 'unreceipted_card_clearing' END
+     WHEN 'provider_refund' THEN 'provider_refund_suspense'
+     WHEN 'chargeback' THEN 'chargebacks' WHEN 'chargeback_reversal' THEN 'chargebacks'
+     WHEN 'reserve_hold' THEN 'processor_reserve' WHEN 'reserve_release' THEN 'processor_reserve' END,
+     -l.gross_minor FROM settlement_line l LEFT JOIN external_reversal_applied e USING(batch_id,remote_id)
+     WHERE l.batch_id=batch_key AND l.entry_kind<>'fee'
+ ) entries GROUP BY account HAVING sum(amount)<>0;
+ SELECT coalesce(sum(amount_minor),0) INTO residual FROM settlement_journal WHERE batch_id=batch_key;
+ IF residual<>0 THEN RAISE EXCEPTION 'payout must balance before close' USING ERRCODE='23514'; END IF;
+END $$;
