@@ -0,0 +1,169 @@
+package server
+
+import (
+	"context"
+	"errors"
+	stdmaps "maps"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+func verifyClassificationCorrections(t *testing.T, db *pgxpool.Pool, users map[string]*officeHTTPSession, batch, first, second string) {
+	t.Helper()
+	const prefix = "finance.settlement.classification."
+	author, reviewer := users["finance"], users["owner-a"]
+	initial := func(adjustment string) map[string]any {
+		return map[string]any{"id": adjustment, "batchId": batch, "category": concessionCategory,
+			"reason": "Invoice attached to wrong customer", "evidenceRef": "CASE/incorrect"}
+	}
+	review := func(adjustment, id string) map[string]any {
+		return map[string]any{"id": adjustment, "batchId": batch, "proposalId": id}
+	}
+	proposal := initial(first)
+	firstID := author.command(prefix+"propose", proposal, "", 200)["id"].(string)
+	secondID := author.command(prefix+"propose", initial(second), "", 200)["id"].(string)
+
+	// Bypass the HTTP writer lock to prove the database itself rejects a
+	// competing decision even when neither writer could see the other at start.
+	raceOppositeClassifications(t, db, firstID, true)
+	raceOppositeClassifications(t, db, secondID, false)
+	reviewer.command(prefix+"approve", review(first, firstID), "", 409)
+
+	lookup := func(ref string) map[string]any {
+		t.Helper()
+		data := reviewer.request("GET", "/api/settlement/lookup?ref="+ref, nil, "", 200)
+		rows := data["providerRefunds"].([]any)
+		if len(rows) != 1 {
+			t.Fatalf("lookup %s yielded %d cases", ref, len(rows))
+		}
+		return rows[0].(map[string]any)
+	}
+	if got := lookup(second); got["classificationStatus"] != "approved" || got["canCorrect"] != false {
+		t.Fatalf("the second adjustment acquired the wrong disposition: %v", got)
+	}
+	corrected := stdmaps.Clone(proposal)
+	corrected["supersedesId"], corrected["reason"], corrected["evidenceRef"] = secondID, "Verified service recovery agreement", "CASE/second"
+	author.command(prefix+"propose", corrected, "", 409) // same bank batch, different case
+	corrected["supersedesId"] = firstID
+	revision2 := author.command(prefix+"propose", corrected, "", 200)["id"].(string)
+	if again := author.command(prefix+"propose", corrected, "", 200); again["id"] != revision2 {
+		t.Fatal("correction replay forked the proposal", again)
+	}
+
+	back := review(first, revision2)
+	back["reason"] = "The cited evidence is for another date"
+	author.command(prefix+"return", back, "", 403)
+	users["cashier"].command(prefix+"return", back, "", 403)
+	originalKey := newOfficeKey()
+	reviewer.command(prefix+"return", back, originalKey, 200) // a replacement reference can be supplied later
+	incorrectReturn := stdmaps.Clone(back)
+	incorrectReturn["reason"] = "Revise the original reason silently"
+	reviewer.command(prefix+"return", incorrectReturn, "", 409)
+	users["owner-b"].command(prefix+"return", back, "", 409)
+	reviewer.command(prefix+"approve", review(first, revision2), "", 409)
+
+	latest := stdmaps.Clone(corrected)
+	latest["supersedesId"] = revision2
+	latest["evidenceRef"] = "CASE/verified-document"
+	revision3 := author.command(prefix+"propose", latest, "", 200)["id"].(string)
+	author.command(prefix+"approve", review(first, revision3), "", 403)
+	reviewer.command(prefix+"approve", review(first, revision3), "", 200)
+	reviewer.command(prefix+"approve", review(first, revision3), "", 200)
+	reviewer.command(prefix+"return", back, originalKey, 200)
+	reviewer.command(prefix+"return", back, "", 200)
+	attemptedReturn := stdmaps.Clone(back)
+	attemptedReturn["proposalId"] = revision3
+	reviewer.command(prefix+"return", attemptedReturn, "", 409)
+
+	data := lookup(first)
+	history := data["classificationHistory"].([]any)
+	if len(history) != 3 || data["proposalId"] != revision3 || data["classificationStatus"] != "approved" {
+		t.Fatalf("incorrect effective version or history: %v", data)
+	}
+	for i, term := range []map[string]any{proposal, corrected, latest} {
+		v := history[i].(map[string]any)
+		if v["revision"] != float64(i+1) || v["reason"] != term["reason"] || v["evidenceRef"] != term["evidenceRef"] ||
+			v["classificationStatus"] != []string{"returned", "returned", "approved"}[i] {
+			t.Fatalf("unexpected revision %d: %v", i+1, v)
+		}
+	}
+	middle := history[1].(map[string]any)
+	if middle["returnReason"] != back["reason"] || middle["supersedesId"] != firstID ||
+		history[2].(map[string]any)["supersedesId"] != revision2 {
+		t.Fatalf("correction broke the review history: %v", history)
+	}
+	if _, err := db.Exec(context.Background(), "UPDATE provider_refund_classification_return SET reason='edited reason' WHERE proposal_id=$1", revision2); err == nil {
+		t.Fatal("editing the original return succeeded")
+	}
+}
+
+// Leave the first transaction uncommitted and wait until PostgreSQL reports
+// that the opposite decision is blocked by that specific backend. The two
+// callers share no application lock. Exercise both possible winning writes.
+func raceOppositeClassifications(t *testing.T, db *pgxpool.Pool, proposal string, returnFirst bool) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	approve := "INSERT INTO provider_refund_classification_approval(proposal_id,approved_by) SELECT $1,id FROM staff WHERE username='owner-b'"
+	sendBack := "INSERT INTO provider_refund_classification_return(proposal_id,returned_by,reason) SELECT $1,id,'Check original evidence' FROM staff WHERE username='owner-a'"
+	first, second := approve, sendBack
+	if returnFirst {
+		first, second = sendBack, approve
+	}
+	leader, err := db.Begin(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer leader.Rollback(context.Background())
+	if _, err = leader.Exec(ctx, first, proposal); err != nil {
+		t.Fatal(err)
+	}
+	follower, err := db.Acquire(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer follower.Release()
+	leaderPID, followerPID := int32(leader.Conn().PgConn().PID()), int32(follower.Conn().PgConn().PID())
+	done := make(chan error, 1)
+	go func() {
+		_, e := follower.Exec(ctx, second, proposal)
+		done <- e
+	}()
+	// Release or cancel the competing transaction before giving its connection
+	// back to the pool, including when an assertion fails.
+	consumed := false
+	defer func() {
+		if !consumed {
+			cancel()
+			<-done
+		}
+	}()
+	for {
+		select {
+		case err = <-done:
+			consumed = true
+			t.Fatalf("opposite decision completed before the first committed: %v", err)
+		default:
+		}
+		var blocked bool
+		if err = db.QueryRow(ctx, "SELECT $1::int=ANY(pg_blocking_pids($2))", leaderPID, followerPID).Scan(&blocked); err != nil {
+			t.Fatal(err)
+		}
+		if blocked {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if err = leader.Commit(ctx); err != nil {
+		t.Fatal(err)
+	}
+	err = <-done
+	consumed = true
+	var pgErr *pgconn.PgError
+	if !errors.As(err, &pgErr) || (pgErr.Code != "23505" && pgErr.Code != "23514") {
+		t.Fatalf("unexpected response to conflicting decision: %v", err)
+	}
+}
