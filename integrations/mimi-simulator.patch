+func TestDakimExternallyDeclinedOriginalRefund(t *testing.T) {
+	job := CardJob{Kind: "refund", ID: "request", Remote: "dr_refund", Original: "dp_charge", Provider: "dakim-simulator", Merchant: "mimi", Currency: "USD", Digits: 2, Amount: 120, Reader: "MIMI-01"}
+	for _, tc := range []struct{ reference, want string }{{`,"reference":""`, "declined"}, {"", "unknown"}, {`,"reference":null`, "unknown"}, {`,"reference":"rf_paid"`, "unknown"}} {
+		s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != "GET" || r.URL.Path != "/v1/refunds/dr_refund" {
+				t.Error("unexpected refund instruction")
+			}
+			fmt.Fprintf(w, `{"id":"dr_refund","amount":120,"currency":"USD","merchant_id":"mimi","payment_id":"dp_charge","merchant_operation":"request","status":"declined"%s}`, tc.reference)
+		}))
+		d := DakimSimulator{base: s.URL, client: s.Client()}
+		fact, err := d.OriginalReference(context.Background(), job)
+		s.Close()
+		if err != nil || fact.State != tc.want {
+			t.Fatal(tc, fact, err)
+		}
+	}
