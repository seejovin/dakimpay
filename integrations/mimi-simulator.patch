+// Exercise a second, independent provider adapter. Only its bank-matched
+// statement can prove the subsequent debit, even when the import looks valid.
+type adjustmentFixture struct {
+	Terminal
+	notice    providerRefund
+	statement providerStatement
+	posted    bool
+}
+
+func (f *adjustmentFixture) RefundNotices(_ context.Context, after int64) (refundPage, error) {
+	page := refundPage{Refunds: []providerRefund{}, Next: &after}
+	if f.notice.Sequence > after {
+		page.Refunds = append(page.Refunds, f.notice)
+		after = f.notice.Sequence
+	}
+	return page, nil
+}
+func (f *adjustmentFixture) PostedStatement(_ context.Context, id string) (providerStatement, error) {
+	if !f.posted || f.statement.Payout != id {
+		return providerStatement{}, errors.New("bank has not posted")
+	}
+	return f.statement, nil
+}
