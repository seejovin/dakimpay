@@ -0,0 +1,19 @@
+#!/bin/sh
+# Dedicated training-store installation for the independent dakim pay simulation.
+set -eu
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+paystate=${DAKIM_STATE_DIR:-"$HOME/.local/share/dakim-pay"}
+export MIMI_LOCAL_DIR=${MIMI_LOCAL_DIR:-"$paystate/mimi-merchant"}
+export MIMI_PG_PORT=${MIMI_PG_PORT:-55494}
+export MIMI_LISTEN=${MIMI_LISTEN:-127.0.0.1:8379}
+export MIMI_DAKIM_URL=${MIMI_DAKIM_URL:-http://127.0.0.1:${DAKIM_PAY_PORT:-8460}}
+export MIMI_DAKIM_TOKEN_FILE="$paystate/merchant_token.key"
+export MIMI_CARD_MODE=dakim-simulator
+case "${1:-}" in
+ start)
+   [ -s "$MIMI_DAKIM_TOKEN_FILE" ] || { echo 'Start the separate dakim pay simulator first.' >&2; exit 1; }
+   if [ ! -f "$MIMI_LOCAL_DIR/first-sign-in.tsv" ]; then "$repo/scripts/mimi-local" setup --training; fi
+   exec "$repo/scripts/mimi-local" start ;;
+ stop|status) exec "$repo/scripts/mimi-local" "$1" ;;
+ *) echo 'Usage: scripts/mimi-dakim start|status|stop' >&2; exit 2 ;;
+esac
