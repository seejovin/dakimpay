#!/usr/bin/env python3
"""Run the isolated local dakim pay multi-provider qualification installation."""
import os
from pathlib import Path
import sys

script = Path(__file__).resolve().with_name("gateway-local")
env = dict(os.environ, DAKIM_LOCAL_TOPOLOGY="aggregator")
env.setdefault("DAKIM_GATEWAY_STATE", str(Path.home() / ".local/share/dakim-aggregator"))
os.execve(sys.executable, [sys.executable, str(script), *sys.argv[1:]], env)
