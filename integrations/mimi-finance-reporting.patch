new file mode 100644
index 0000000..bf8454f
--- /dev/null
+++ b/migrations/145_refund_classification.sql
@@ -0,0 +1,64 @@
+-- Reporting eligibility follows both posted bank movements and the exact
+-- refund line. A negative item in a positive net payout is outside this workflow.
+CREATE VIEW classifiable_refund_debit AS
+ SELECT n.provider,n.merchant,n.adjustment_id,n.debit_batch_id AS batch_id
+ FROM provider_refund_case n
+ JOIN settlement_batch original ON original.id=n.original_batch_id
+ JOIN settlement_journal first_bank ON first_bank.batch_id=original.id AND first_bank.account='bank'
+ JOIN settlement_batch debit ON debit.id=n.debit_batch_id
+ JOIN provider_statement_check ck ON ck.batch_id=debit.id AND ck.verified_at IS NOT NULL
+ JOIN settlement_line l ON l.batch_id=debit.id AND l.remote_id=n.adjustment_id
+ JOIN settlement_journal bank ON bank.batch_id=debit.id AND bank.account='bank'
+ JOIN settlement_journal suspense ON suspense.batch_id=debit.id AND suspense.account='provider_refund_suspense'
+ WHERE n.receipt_id IS NOT NULL AND n.original_batch_id<>n.debit_batch_id
+ AND n.original_bank<>debit.bank_ref AND original.status='closed' AND debit.status='closed'
+ AND first_bank.amount_minor=n.original_deposit_minor AND n.original_deposit_minor>0
+ AND debit.deposit_minor<0 AND bank.amount_minor=debit.deposit_minor AND suspense.amount_minor>=n.amount_minor
+ AND debit.provider=n.provider AND debit.merchant=n.merchant AND debit.currency=n.currency
+ AND debit.decided_at>=original.decided_at
+ AND l.entry_kind='provider_refund' AND l.gross_minor=-n.amount_minor AND l.original_ref=n.payment_ref;
+
+CREATE TABLE provider_refund_classification_proposal (
+ id text PRIMARY KEY DEFAULT gen_random_uuid()::text, provider text NOT NULL, merchant text NOT NULL,
+ adjustment_id text NOT NULL,batch_id text NOT NULL, category text NOT NULL CHECK(category='merchant_funded_service_concession'),
+ reason text NOT NULL CHECK(char_length(reason) BETWEEN 4 AND 240 AND reason=btrim(reason) AND reason !~ '[[:cntrl:]]'),
+ evidence_ref text NOT NULL CHECK(evidence_ref ~ '^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$'),
+ proposed_by text NOT NULL REFERENCES staff, proposed_at timestamptz NOT NULL DEFAULT now(),
+ UNIQUE(provider,merchant,adjustment_id),
+ FOREIGN KEY(provider,merchant,adjustment_id) REFERENCES provider_refund_applied,
+ FOREIGN KEY(batch_id,adjustment_id) REFERENCES settlement_line(batch_id,remote_id)
+);
+CREATE TABLE provider_refund_classification_approval (
+ proposal_id text PRIMARY KEY REFERENCES provider_refund_classification_proposal,
+ approved_by text NOT NULL REFERENCES staff, approved_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE FUNCTION validate_refund_classification() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE
+ p provider_refund_classification_proposal%ROWTYPE;
+ actor_id text;
+BEGIN
+ IF TG_TABLE_NAME='provider_refund_classification_proposal' THEN
+   p:=NEW;
+   actor_id:=p.proposed_by;
+ ELSE
+   SELECT * INTO STRICT p FROM provider_refund_classification_proposal WHERE id=NEW.proposal_id;
+   actor_id:=NEW.approved_by;
+   IF actor_id=p.proposed_by THEN
+     RAISE EXCEPTION 'independent classification approval required' USING ERRCODE='23514';
+   END IF;
+ END IF;
+ IF NOT EXISTS(SELECT FROM staff WHERE id=actor_id AND active AND role IN ('finance','supervisor','owner'))
+ OR NOT EXISTS(SELECT FROM classifiable_refund_debit d WHERE
+ (d.provider,d.merchant,d.adjustment_id,d.batch_id)=(p.provider,p.merchant,p.adjustment_id,p.batch_id))
+ THEN RAISE EXCEPTION 'ineligible refund classification or reviewer' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER validate_refund_proposal BEFORE INSERT ON provider_refund_classification_proposal
+ FOR EACH ROW EXECUTE FUNCTION validate_refund_classification();
+CREATE TRIGGER validate_refund_approval BEFORE INSERT ON provider_refund_classification_approval
+ FOR EACH ROW EXECUTE FUNCTION validate_refund_classification();
+CREATE TRIGGER keep_refund_proposal BEFORE UPDATE OR DELETE ON provider_refund_classification_proposal
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
+CREATE TRIGGER keep_refund_approval BEFORE UPDATE OR DELETE ON provider_refund_classification_approval
+ FOR EACH ROW EXECUTE FUNCTION protect_history();
