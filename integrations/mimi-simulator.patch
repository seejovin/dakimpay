+func TestDakimRejectsDuplicateFinancialEvidence(t *testing.T) {
+	job := CardJob{ID: "order", Kind: "charge", Remote: "dp_sale", Amount: 360, Currency: "USD", Digits: 2, Merchant: "mimi", Provider: "dakim-simulator", Reader: "MIMI-01"}
+	wire, err := json.Marshal(testDakimReversal(job.ID, 100, 260))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct{ name, field, replacement string }{
+		{"dispute status", `"dispute_status":"none"`, `"dispute_status":"open","dispute_status":"none"`},
+		{"dispute key alias", `"dispute_status":"none"`, `"DISPUTE_STATUS":"unknown","dispute_status":"none"`},
+		{"refund amount", `"amount":100`, `"amount":1,"amount":100`},
+		{"refund amount alias", `"amount":100`, `"Amount":99,"amount":100`},
+		{"source payment reference", `"reference":"ch_test-sale"`, `"reference":"ch_other","reference":"ch_test-sale"`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			bad := bytes.Replace(wire, []byte(tc.field), []byte(tc.replacement), 1)
+			if bytes.Equal(bad, wire) {
+				t.Fatal("fixture failed to insert duplicate")
+			}
+			api := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { _, _ = w.Write(bad) }))
+			defer api.Close()
+			d := DakimSimulator{base: api.URL, client: api.Client()}
+			if proof, err := d.FullReversal(context.Background(), job); err == nil || proof.Charge != "" || len(proof.Refunds) != 0 {
+				t.Fatal("ambiguous response authorized release", proof, err)
+			}
+		})
+	}
